#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# control creates control.db and github_app.json itself; both hold secrets, so keep them to abc
mkdir -p \
    /config

# permissions
lsiown abc:abc \
    /config
chmod 700 \
    /config

# s6 keeps the container's environment (control's secrets from .env) as world-readable files; command version
# sources run as nobody (run-version-command), so only root may read them. Services read them as root first.
chmod 700 \
    /run/s6/container_environment
